@@ -31,3 +37,27 @@
 
 } // namespace style
 } // namespace mln
+
+#if MLN_RENDER_BACKEND_WEBGPU
+namespace mln::style::webgpu {
+
+CustomLayerRenderParameters::CustomLayerRenderParameters(const mln::PaintParameters& parameters)
+    : mln::style::CustomLayerRenderParameters(parameters) {
+    auto& backend = static_cast<mln::webgpu::RendererBackend&>(parameters.backend);
+    encoder = reinterpret_cast<std::uintptr_t>(
+        static_cast<mln::webgpu::RenderPass&>(*parameters.renderPass).getEncoder());
+    colorFormat = static_cast<uint32_t>(backend.getColorFormat());
+    depthStencilFormat = static_cast<uint32_t>(backend.getDepthStencilFormat());
+    // Native matrices are built bottom-to-top during upload, whereas the draw
+    // pass numbers currentLayer top-to-bottom. Use the upload index for depth.
+    projectionMatrix = parameters.state.isChanging() ? parameters.transformParams.projMatrix
+                                                    : parameters.transformParams.alignedProjMatrix;
+    depthTest = !globe && parameters.currentLayer >= parameters.opaquePassCutoff;
+    const auto depthIndex = parameters.layerGroupCount - 1 - parameters.currentLayer;
+    depthOffset = (1 + depthIndex) * mln::PaintParameters::numSublayers *
+                  mln::PaintParameters::depthEpsilon;
+    projectionMatrix[14] -= depthOffset;
+}
+
+} // namespace mln::style::webgpu
+#endif
