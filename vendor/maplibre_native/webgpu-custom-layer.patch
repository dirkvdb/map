+#pragma once
+
+#include <mln/style/layers/custom_layer_render_parameters.hpp>
+#include <cstdint>
+
+namespace mln::style::webgpu {
+
+// Encoder and attachment formats are borrowed only for CustomLayerHost::render.
+// The host must not end the pass or retain its encoder after the callback.
+struct CustomLayerRenderParameters : mln::style::CustomLayerRenderParameters {
+    std::uintptr_t encoder;
+    uint32_t colorFormat;
+    uint32_t depthStencilFormat;
+    bool depthTest;
+
+    explicit CustomLayerRenderParameters(const mln::PaintParameters&);
+};
+
+} // namespace mln::style::webgpu
