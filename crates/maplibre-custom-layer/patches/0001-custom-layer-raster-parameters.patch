+    // Upload visits groups bottom-to-top; draw numbers them top-to-bottom.
+    // preRender now runs during group upload, after group membership is final.
+    assert(paintParameters.layerGroupCount > 0);
+    assert(paintParameters.currentLayer < paintParameters.layerGroupCount);
+    const auto reverseIndex = paintParameters.layerGroupCount - 1 - paintParameters.currentLayer;
+    [[maybe_unused]] const auto uploadIndex = paintParameters.layerGroupUpload ? paintParameters.currentLayer : reverseIndex;
+    const auto drawIndex = paintParameters.layerGroupUpload ? reverseIndex : paintParameters.currentLayer;
+    depthTest = drawIndex >= paintParameters.opaquePassCutoff;
+    pixelRatio = paintParameters.pixelRatio;
+    rasterProjectionMatrix = paintParameters.transformParams.alignedProjMatrix;
+    flatDepthOffset = 0.0;
+#if !MLN_RENDER_BACKEND_OPENGL
+    if (depthTest) {
+        // Match LayerTweaker::multiplyWithProjectionMatrix, raster sublayer 0,
+        // including its float arithmetic before promotion to a matrix double.
+        flatDepthOffset = (1 + uploadIndex) * PaintParameters::numSublayers * PaintParameters::depthEpsilon;
+        rasterProjectionMatrix[14] -= flatDepthOffset;
+    }
+#endif
 }
 
